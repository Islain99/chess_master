PORT=3001
STOCKFISH_PATH=stockfish
# Sur macOS : brew install stockfish → /opt/homebrew/bin/stockfish
# Sur Ubuntu : apt install stockfish → /usr/games/stockfish
# Sur Alpine (Docker) : apk add stockfish → /usr/bin/stockfish

# Base de données (partagée avec l'API)
DATABASE_URL=postgresql://chess:chess@localhost:5432/chess
