# ─────────────────────────────────────────────────────────────────────────────
# API — variables d'environnement (copier en .env, jamais committer le .env)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://chess:chess@localhost:5432/chess
REDIS_URL=redis://localhost:6379
PORT=3000
CORS_ORIGIN=*
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
AI_ENGINE_URL=http://localhost:3001

# ─── OAuth (sprint 15) — vide = fournisseur désactivé (503) ──────────────────
# Audiences acceptées pour les ID tokens Google : client IDs OAuth de type
# Web (utilisé aussi comme serverClientId Android), iOS et macOS.
GOOGLE_CLIENT_IDS=
# Audiences Apple : bundle ID iOS/macOS + Services ID (Android et Web).
APPLE_CLIENT_IDS=
# Package Android vers lequel /auth/oauth/apple/callback redirige.
APPLE_ANDROID_PACKAGE=com.islain99.chess_client
# Application Meta (le secret ne quitte jamais le serveur).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Notifications push FCM (sprint 16) — vide = push désactivé ──────────────
# Compte de service Firebase (console Firebase > Paramètres > Comptes de service
# > Générer une clé privée) : contenu JSON brut ou encodé en base64…
FCM_SERVICE_ACCOUNT=
# …ou ses trois champs séparés (les « \n » de la clé sont acceptés) :
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# URL HTTPS publique du client Web : lien ouvert au clic sur une notification.
PUBLIC_WEB_URL=
