# ─────────────────────────────────────────────────────────────────────────────
# Production VPS — copier en .env (jamais committé) puis remplir.
# Générer les secrets avec :  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# Nom de domaine qui pointe (enregistrement A) vers l'IP du Droplet.
# Pas encore de domaine ? Utilise <IP-avec-tirets>.sslip.io, par ex.
#   DOMAIN=164-90-12-34.sslip.io
DOMAIN=chess.example.com
# Adresse pour les avis Let's Encrypt (expiration de certificat).
ACME_EMAIL=toi@example.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=

# Part de CPU laissée à Stockfish (1.0 = un cœur entier).
# Droplet 1 vCPU : 0.75 (l'API garde de la marge). Droplet 2 vCPU : 1.0.
AI_ENGINE_CPUS=0.75

# Adresse affichée dans la politique de confidentialité (/confidentialite.html).
# Vide = ACME_EMAIL.
CONTACT_EMAIL=

# ─── Optionnel : OAuth (vide = fournisseur désactivé) ───────────────────────
# Voir docs/deploiement-vps.md, « Connexion Google et Facebook ».
# Client ID Google de type « Web » : bouton du site, et audience des jetons
# de l'application Android.
GOOGLE_WEB_CLIENT_ID=
# Client IDs acceptés par l'API (au minimum le client Web ci-dessus).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
APPLE_ANDROID_PACKAGE=com.islain99.chess_client
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Optionnel : notifications push (vide = désactivé) ─────────────────────
# API : compte de service Firebase, JSON encodé en base64 sur une ligne
#   base64 -w0 compte-de-service.json
FCM_SERVICE_ACCOUNT=
# Site Web : configuration de l'application Web Firebase (valeurs publiques)
FIREBASE_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_VAPID_KEY=
